{
  "$schema": "https://recomplauncher.com/schema/recomplauncher.json",
  "format": 1,
  "name": "FIFA Street 3 (barebone PC port)",
  "repo": "Simon3Sarkis/fifa-street-3-pc-recomp",
  "inputs": [
    {
      "id": "game",
      "role": "game",
      "label": "Your own FIFA Street 3 for Xbox 360: the disc image (.iso), or a folder with its extracted files (default.xex). Nothing is extracted from an .iso; the game reads it as it is.",
      "formats": [
        {
          "type": "file",
          "extensions": [
            "iso"
          ]
        },
        {
          "type": "folder"
        }
      ],
      "check": {
        "ids": [
          "4541083B"
        ]
      }
    }
  ],
  "start": {
    "program": [
      "fifastreet3.exe",
      "fifastreet3"
    ],
    "args": [
      "--launcher=false"
    ]
  },
  "config": [
    {
      "id": "main",
      "format": "toml",
      "file": [
        {
          "path": "{install}/fifastreet3.user.toml"
        }
      ],
      "game_path": "game_data_root"
    }
  ],
  "saves": [
    "{install}/userdata"
  ],
  "folders": {
    "saves": [
      {
        "path": "{install}/userdata"
      }
    ],
    "logs": [
      {
        "path": "{install}/logs"
      }
    ]
  },
  "exit_codes": {
    "0": "ok"
  },
  "system": {
    "windows": {
      "version": "10"
    },
    "linux": {
      "glibc": "2.39"
    }
  },
  "groups": [
    {
      "id": "Display"
    },
    {
      "id": "Graphics"
    }
  ],
  "settings": [
    {
      "id": "screen_mode",
      "label": "Screen mode",
      "help": "Borderless covers the screen without changing the display mode. Exclusive takes over the display. On Windows a window can drop below 60 FPS (the desktop compositor).",
      "group": "Display",
      "choices": [
        {
          "label": "Borderless fullscreen",
          "set": {
            "fullscreen": "true",
            "fullscreen_mode": "'borderless'"
          }
        },
        {
          "label": "Exclusive fullscreen",
          "set": {
            "fullscreen": "true",
            "fullscreen_mode": "'exclusive'"
          }
        },
        {
          "label": "Windowed",
          "set": {
            "fullscreen": "false"
          }
        }
      ],
      "defaults": {
        "fullscreen": "true",
        "fullscreen_mode": "'borderless'"
      }
    },
    {
      "id": "vsync",
      "label": "VSync",
      "help": "On: no tearing. Off: the least delay.",
      "group": "Display",
      "choices": [
        {
          "label": "Off",
          "set": {
            "vulkan_allow_present_mode_immediate": "true",
            "vulkan_allow_present_mode_mailbox": "true"
          }
        },
        {
          "label": "On",
          "set": {
            "vulkan_allow_present_mode_immediate": "false",
            "vulkan_allow_present_mode_mailbox": "false"
          }
        }
      ],
      "defaults": {
        "vulkan_allow_present_mode_immediate": "true",
        "vulkan_allow_present_mode_mailbox": "true"
      }
    },
    {
      "id": "show_fps",
      "label": "Show FPS",
      "group": "Display",
      "choices": [
        {
          "label": "Off",
          "set": {
            "show_fps_counter": "false"
          }
        },
        {
          "label": "On",
          "set": {
            "show_fps_counter": "true"
          }
        }
      ],
      "defaults": {
        "show_fps_counter": "false"
      }
    },
    {
      "id": "resolution",
      "label": "Resolution",
      "help": "What the game is drawn at, then fitted to your screen. The game's own modes are 720p and 1080p; 1440p and 4K draw them larger (more GPU work). Keep 1280 x 720 on the Steam Deck.",
      "group": "Graphics",
      "choices": [
        {
          "label": "1280 x 720 (original)",
          "set": {
            "resolution": "'720p'",
            "draw_resolution_scale_x": "1",
            "draw_resolution_scale_y": "1"
          }
        },
        {
          "label": "1920 x 1080",
          "set": {
            "resolution": "'1080p'",
            "draw_resolution_scale_x": "1",
            "draw_resolution_scale_y": "1"
          }
        },
        {
          "label": "2560 x 1440",
          "set": {
            "resolution": "'720p'",
            "draw_resolution_scale_x": "2",
            "draw_resolution_scale_y": "2"
          }
        },
        {
          "label": "3840 x 2160",
          "set": {
            "resolution": "'1080p'",
            "draw_resolution_scale_x": "2",
            "draw_resolution_scale_y": "2"
          }
        }
      ],
      "defaults": {
        "resolution": "'720p'",
        "draw_resolution_scale_x": "1",
        "draw_resolution_scale_y": "1"
      }
    }
  ]
}
